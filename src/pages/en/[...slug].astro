---
/** Every topic page (src/content/guides), state page (src/content/states) and local tax page (src/content/local). */
import ContentPage from '../../components/ContentPage.astro';
import StatePage from '../../components/StatePage.astro';
import LocalPage from '../../components/LocalPage.astro';
import { GUIDES, STATE_PAGES, LOCAL_PAGES } from '../../lib/pages';
export function getStaticPaths() {
  return [
    ...GUIDES.map((page) => ({ params: { slug: page.slug }, props: { kind: 'g', def: page } })),
    ...STATE_PAGES.map((def) => ({ params: { slug: def.slug }, props: { kind: 's', def } })),
    ...LOCAL_PAGES.map((def) => ({ params: { slug: `${def.state}/${def.place}` }, props: { kind: 'c', def } })),
  ];
}
const { kind, def } = Astro.props as { kind: 'g' | 's' | 'c'; def: any };
---
{kind === 'g' ? <ContentPage page={def} /> : kind === 's' ? <StatePage def={def} /> : <LocalPage def={def} />}
